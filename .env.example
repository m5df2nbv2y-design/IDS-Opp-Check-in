# ---------------------------------------------------------------------------
# Local development defaults. Copy to .env and adjust.
# ---------------------------------------------------------------------------

# SQLite for local dev. For Vercel, use a Postgres connection string —
# the driver adapter is chosen from the scheme, no code change required.
#   DATABASE_URL="postgresql://user:password@host:5432/ids_checkin"
DATABASE_URL="file:./dev.db"

# Public origin used to build the personalized links inside check-in emails.
# On Vercel this defaults to the production URL if unset.
APP_BASE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Salesforce / SFX
# ---------------------------------------------------------------------------
# "mock"       — the demo org in src/server/integrations/salesforce/mock
# "salesforce" — the real REST integration (requires the credentials below)
SALESFORCE_PROVIDER="mock"

# SF_LOGIN_URL="https://login.salesforce.com"
# SF_INSTANCE_URL="https://ids.my.salesforce.com"
# SF_CLIENT_ID=""
# SF_CLIENT_SECRET=""
# SF_USERNAME=""
# SF_PASSWORD=""

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# "mock"   — captured in the in-app outbox, nothing is delivered
# "resend" — example real provider; the template for M365 / SendGrid
EMAIL_PROVIDER="mock"
EMAIL_FROM_NAME="IDS Sales Operations"
EMAIL_FROM_ADDRESS="sales-ops@ids.example.com"
# RESEND_API_KEY=""

# How long a personalized check-in link stays valid.
CHECKIN_TOKEN_TTL_DAYS="45"

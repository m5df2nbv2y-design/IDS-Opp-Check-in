# ===========================================================================
# IDS Opportunity Check-In — environment configuration
# ===========================================================================
# Copy to .env for local development. NEVER commit a filled-in .env: the whole
# .env* family is gitignored apart from this example.
#
# Everything here is read on the SERVER only. Nothing is prefixed NEXT_PUBLIC_,
# so no value in this file is ever sent to the browser.
#
# Values marked [DEV ONLY] are local conveniences and are refused in a
# production build. Production does not default: a missing required value is a
# startup error naming exactly what is absent (src/lib/production-config.ts).
# Full deployment guide: docs/PRODUCTION-DEPLOYMENT.md
# ===========================================================================


# ---------------------------------------------------------------------------
# APPLICATION
# ---------------------------------------------------------------------------
# "development" locally; set to "production" by the host when deployed.
# NODE_ENV="development"

# Public origin used to build the personalized check-in links inside customer
# email. REQUIRED in production — a localhost value is refused, because the
# links are opened by customers on their own machines. On Vercel this falls
# back to VERCEL_PROJECT_PRODUCTION_URL if unset.
APP_BASE_URL="http://localhost:3000"


# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# PostgreSQL everywhere — local, test, and production run the same engine, so
# there is no dialect gap between what is developed and what is deployed.
#
# Local development uses the Docker container started by `npm run db:up`.
# Production points at a managed instance:
#   DATABASE_URL="postgresql://user:password@host:5432/ids_checkin?sslmode=require"
#
# In production a missing DATABASE_URL is a startup error, and a non-PostgreSQL
# URL is refused outright rather than quietly adapted.
DATABASE_URL="postgresql://ids:ids_local_dev@localhost:5432/ids_checkin?schema=public"


# ---------------------------------------------------------------------------
# AUTHENTICATION — Microsoft Entra ID
# ---------------------------------------------------------------------------
# Signs the session cookie. REQUIRED in production. Generate with: npx auth secret
AUTH_SECRET=""

# Entra app registration. REQUIRED in production — without it no employee can
# sign in at all.
#   Redirect URI: https://<your-host>/api/auth/callback/microsoft-entra-id
#   Scopes: openid profile email
# AUTH_MICROSOFT_ENTRA_ID_ID=""        # Application (client) ID
# AUTH_MICROSOFT_ENTRA_ID_SECRET=""    # Client secret VALUE (not the secret ID)
# AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"
#   Leave the issuer unset and sign-in is multi-tenant. Set it to the IDS
#   tenant to restrict sign-in to IDS.

# [DEV ONLY] Local sign-in, so the mock demo needs no Entra tenant.
# Structurally impossible in a production build — the credentials provider is
# not registered when NODE_ENV=production — and setting it in production is
# refused at startup.
AUTH_DEV_BYPASS="true"


# ---------------------------------------------------------------------------
# AUTHORIZATION — who may use /admin
# ---------------------------------------------------------------------------
# Authentication proves identity; this decides who may actually use the console.
# With NEITHER set, NOBODY is authorized — it fails closed rather than admitting
# everyone in the tenant. Production refuses to start without one.
#
# PREFERRED: Entra App Role, granted by assigning the Sales Operations security
# group to the application's App Role. Not subject to the Entra "groups
# overage" that silently drops the groups claim for users in >200 groups.
# This is the VALUE of the App Role, not its display name.
# AUTH_REQUIRED_APP_ROLE="SalesOps.Admin"
#
# FALLBACK: raw Entra security group object id, if App Roles are unavailable.
# AUTH_REQUIRED_GROUP_ID="00000000-0000-0000-0000-000000000000"


# ---------------------------------------------------------------------------
# SALESFORCE / SFX
# ---------------------------------------------------------------------------
# "mock"       — the demo org in src/server/integrations/salesforce/mock
# "salesforce" — the real REST integration (requires the credentials below)
#
# Production REQUIRES "salesforce": the mock org would present fabricated
# pipeline as though it were real.
SALESFORCE_PROVIDER="mock"

# Verify a real org before switching the provider:  npm run sf:smoke
# (read-only — authenticates, describes objects, counts records, writes nothing)
#
# "client_credentials" (default) — External Client App acting as its configured
#   "Run As" user. Only the key and secret are needed; the integration identity
#   is set in Salesforce, not sent in the request. This is the production flow.
#   Requires on the External Client App: OAuth Settings → Flow Enablement →
#   "Enable Client Credentials Flow", and Policies → Run As = integration user.
# "password" — legacy username/password grant. NOT for production: it binds the
#   integration to a human's credentials.
# SF_AUTH_FLOW="client_credentials"
#
# For client credentials, use the org's My Domain host, NOT login.salesforce.com:
#   production  https://idsculpture.my.salesforce.com
#   sandbox     https://idsculpture--<sandbox>.sandbox.my.salesforce.com
# SF_LOGIN_URL=""
#
# Optional — the token response already returns the right instance URL.
# SF_INSTANCE_URL=""
#
# SF_CLIENT_ID=""                    # External Client App Consumer Key
# SF_CLIENT_SECRET=""                # External Client App Consumer Secret
#
# Optional. When set, `npm run sf:smoke` asserts the authenticated identity
# matches it exactly — catching a Run As user that has been changed to someone's
# personal account. Not a credential; not used for authentication.
# SF_EXPECTED_USERNAME="ids.opportunity.checkin@idsculpture.com"
#
# Only for SF_AUTH_FLOW="password" — not used by the production flow:
# SF_USERNAME=""
# SF_PASSWORD=""                     # password + security token, concatenated, no space

# --- Write-back master switch ------------------------------------------
# Anything but "true" keeps Salesforce READ-ONLY. The recipient's response is
# still recorded and shown; it is simply not pushed. The eventual write scope is
# Opportunity.StageName and Opportunity.CloseDate ONLY.
# KEEP THIS "false" until write-back is deliberately commissioned.
SALESFORCE_WRITE_ENABLED="false"


# ---------------------------------------------------------------------------
# SMARTSHEET (signal source — reminders, tasks, comments)
# ---------------------------------------------------------------------------
# "mock"       — fixed demo signals in src/server/integrations/smartsheet/mock
# "smartsheet" — the real integration (not implemented yet; see live/)
SMARTSHEET_PROVIDER="mock"

# SMARTSHEET_BASE_URL="https://api.smartsheet.com/2.0"
# SMARTSHEET_API_KEY=""


# ---------------------------------------------------------------------------
# EMAIL
# ---------------------------------------------------------------------------
# "mock"   — captured in the in-app outbox, nothing is delivered
# "resend" — example real provider; the template for M365 / SendGrid
#
# KEEP THIS "mock" until customer email is deliberately commissioned. The demo
# test-email action below sends real mail WITHOUT changing this, so the normal
# customer flow stays simulated.
EMAIL_PROVIDER="mock"
EMAIL_FROM_NAME="IDS Sales Operations"
EMAIL_FROM_ADDRESS="sales-ops@ids.example.com"

# --- Demo test email ---------------------------------------------------
# The ONE address the admin "Send Test Email" action may deliver to. Read only
# on the server; the browser never supplies a recipient. Leave it UNSET and the
# control does not render and the service refuses — it fails closed rather than
# falling back to a real contact's address.
# DEMO_TEST_EMAIL="you@yourcompany.com"
#
# Required for the test-email action only. NEVER commit a real key.
# The From address above must be on a domain verified in Resend, otherwise the
# send is rejected.
# RESEND_API_KEY=""


# ---------------------------------------------------------------------------
# CHECK-IN LINKS
# ---------------------------------------------------------------------------
# How long a personalized check-in link stays valid.
CHECKIN_TOKEN_TTL_DAYS="45"

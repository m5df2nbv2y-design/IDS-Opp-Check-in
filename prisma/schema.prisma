// IDS Opportunity Check-In — workflow + audit datastore.
//
// Salesforce/SFX is the system of record. This database stores only what is
// needed to run a check-in campaign and keep an audit trail.
//
// The central modelling decision: the person who receives a check-in is an
// EXTERNAL CONTACT at a partner organization — not an internal IDS sales rep.
// One contact receives one email covering every opportunity they are
// responsible for, even when those opportunities belong to several different
// IDS reps. The internal rep is retained on each opportunity as internal
// context and is never shown to the external recipient.
//
// Local dev uses SQLite. For production, change the provider to "postgresql"
// and point DATABASE_URL at Postgres — no model changes needed.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// An external organization: agency, distributor, direct client.
/// Maps to a Salesforce Account.
model Account {
  id         String   @id @default(cuid())
  externalId String   @unique
  name       String
  /// AGENCY | DISTRIBUTOR | DIRECT_CLIENT | OTHER — see lib/account-types.ts
  type       String   @default("OTHER")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  contacts      ExternalContact[]
  opportunities Opportunity[]
  auditEvents   AuditEvent[]
  signals       OpportunitySignal[]
}

/// A person at an external organization. This is the check-in RECIPIENT.
/// Maps to a Salesforce Contact.
model ExternalContact {
  id         String   @id @default(cuid())
  externalId String   @unique
  accountId  String
  name       String
  email      String
  /// The account's designated recipient when several contacts exist.
  isPrimary  Boolean  @default(false)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  account       Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
  recipients    CheckInRecipient[]
  auditEvents   AuditEvent[]

  @@index([accountId])
}

/// An internal IDS employee who owns opportunities. Maps to a Salesforce User.
/// Kept for internal reporting and the audit trail — never a recipient.
model SalesRep {
  id         String   @id @default(cuid())
  externalId String   @unique
  name       String
  email      String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  opportunities Opportunity[]
  auditEvents   AuditEvent[]
}

/// Local cache of an open Salesforce/SFX opportunity.
model Opportunity {
  id              String  @id @default(cuid())
  externalId      String  @unique
  /// The partner organization whose contact reviews this opportunity.
  accountId       String
  /// The end customer / project site shown to the recipient, e.g. "Memorial
  /// Hospital". For a direct client this equals the account name.
  customerName    String
  /// Salesforce Opportunity.Name.
  opportunityName String
  /// The project, when captured separately from the opportunity name.
  projectName     String?
  amount          Float
  currentStage    String
  /// The IDS employee who owns this opportunity. Internal only.
  internalRepId   String
  /// The resolved recipient. Null when resolution failed — see resolutionStatus.
  contactId       String?
  /// RESOLVED | UNRESOLVED — set by the recipient resolution service.
  resolutionStatus String @default("UNRESOLVED")
  /// Why the recipient was (or was not) chosen. See recipient-resolution-service.ts
  resolutionReason String?
  salesforceUrl   String
  closeDate       DateTime?
  /// False once the opportunity leaves the open set in Salesforce. Closed
  /// opportunities are kept, never deleted, so past campaigns survive.
  isOpen          Boolean @default(true)

  /// Terminal outcome, captured once the opportunity leaves the open set.
  /// Salesforce's open-opportunity query can never return these values, so they
  /// are fetched deliberately and then frozen — CFO reporting must not depend on
  /// re-reading Salesforce, which overwrites its own history.
  isWon             Boolean?
  finalStage        String?
  finalAmount       Float?
  /// The actual CloseDate on the record when it closed.
  closedAt          DateTime?
  /// When WE observed the outcome, which is not when it happened.
  outcomeObservedAt DateTime?

  lastSyncedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account      Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  internalRep  SalesRep             @relation(fields: [internalRepId], references: [id], onDelete: Cascade)
  contact      ExternalContact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  checkInItems CheckInOpportunity[]
  auditEvents  AuditEvent[]
  signals      OpportunitySignal[]
  selections   CampaignSelection[]
  snapshots    OpportunitySnapshot[]

  @@index([accountId])
  @@index([contactId])
  @@index([internalRepId])
  @@index([isOpen])
}

/// One bi-annual campaign, e.g. "Fall 2026".
model Campaign {
  id          String    @id @default(cuid())
  name        String
  period      String
  status      String    @default("DRAFT") // DRAFT | IN_PROGRESS | COMPLETE
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  recipients  CheckInRecipient[]
  auditEvents AuditEvent[]
  selections  CampaignSelection[]
}

/// One external contact's personalized check-in within a campaign.
/// This is the unit that receives an email and holds the secure token.
model CheckInRecipient {
  id          String    @id @default(cuid())
  campaignId  String
  contactId   String
  /// SHA-256 of the token. The raw token is never stored here, and for a real
  /// email provider it is not stored anywhere — see EmailMessage.linkUrl.
  tokenHash   String    @unique
  /// Short non-secret suffix for admin display and support lookups.
  tokenHint   String
  expiresAt   DateTime
  sentAt      DateTime?
  deliveredAt DateTime?
  openedAt    DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  revokedAt   DateTime?
  /// PENDING | SENT | FAILED — delivery state of the invitation itself.
  sendStatus  String    @default("PENDING")
  sendError   String?
  remindedAt  DateTime?
  reminderCount Int     @default(0)
  createdAt   DateTime  @default(now())

  campaign Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  ExternalContact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  items    CheckInOpportunity[]

  @@unique([campaignId, contactId])
  @@index([contactId])
}

/// One opportunity placed in front of one recipient. The unit of work the
/// recipient answers and the unit synced back to Salesforce.
model CheckInOpportunity {
  id            String @id @default(cuid())
  recipientId   String
  opportunityId String

  /// Snapshot taken when the campaign was created, so the audit trail stays
  /// truthful even if Salesforce changes underneath it.
  customerName     String
  opportunityName  String
  projectName      String?
  amount           Float
  salesforceUrl    String
  accountName      String
  /// Internal rep at the time of asking — audit context, never shown externally.
  internalRepName  String

  previousStatus String
  updatedStatus  String?
  repComment     String?
  submittedAt    DateTime?

  /// Close date modelling for the confirmed future write scope
  /// (StageName + CloseDate). `previousCloseDate` is the value snapshotted from
  /// Salesforce when the campaign launched. `updatedCloseDate` is where a
  /// recipient's revised date will land once that step exists — it is NOT
  /// captured from anyone yet and is NEVER written to Salesforce today.
  previousCloseDate DateTime?
  updatedCloseDate  DateTime?

  /// PENDING | SYNCED | FAILED | SKIPPED
  syncStatus   String    @default("PENDING")
  syncedAt     DateTime?
  syncError    String?
  syncAttempts Int       @default(0)

  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipient   CheckInRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  opportunity Opportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([recipientId, opportunityId])
  @@index([syncStatus])
}

/// Append-only audit trail. Carries the full picture of a change: which
/// opportunity, at which organization, updated by which external contact, for
/// which internal IDS rep, and what Salesforce did with it.
model AuditEvent {
  id            String   @id @default(cuid())
  type          String
  summary       String
  /// Who caused it — an external contact's name, an admin, or "system".
  actor         String
  /// EXTERNAL_CONTACT | ADMIN | SYSTEM
  actorKind     String   @default("SYSTEM")
  fromStatus    String?
  toStatus      String?
  detail        String?
  campaignId    String?
  accountId     String?
  contactId     String?
  repId         String?
  opportunityId String?
  createdAt     DateTime @default(now())

  campaign    Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  account     Account?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contact     ExternalContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  rep         SalesRep?        @relation(fields: [repId], references: [id], onDelete: SetNull)
  opportunity Opportunity?     @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([createdAt])
}

/// Outbox. Every message the app sends, real or simulated.
model EmailMessage {
  id          String    @id @default(cuid())
  provider    String
  kind        String // INVITE | REMINDER
  toEmail     String
  toName      String
  subject     String
  html        String
  text        String
  /// The check-in URL as it appears in the message body.
  ///
  /// For a SIMULATED provider this keeps the live token, so /admin/outbox can
  /// render a working button for the demo — nothing it holds was ever
  /// delivered anywhere. For a REAL provider the token is redacted out of this
  /// field AND out of html/text before the row is written, because the token is
  /// a bearer credential and a database leak must not hand out working links.
  /// See src/server/integrations/email/outbox.ts.
  linkUrl     String?
  campaignId  String?
  contactId   String?
  /// SENT | FAILED. deliveredAt/openedAt are filled in by providers that
  /// report them; the mock provider leaves them null.
  status      String    @default("SENT")
  error       String?
  deliveredAt DateTime?
  openedAt    DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

/// An admin's explicit, per-opportunity selection within a DRAFT campaign.
///
/// Discovery is never authorization to send: an opportunity only becomes
/// sendable when a human has deliberately selected it, and that decision is
/// recorded here so it survives a refresh or navigating away. Keyed by
/// opportunity — never by account — so selecting an account can only ever be
/// shorthand for the specific opportunities shown at the time.
///
/// This is UI workflow state and lives only in this database. Nothing about a
/// selection is ever written to Salesforce.
model CampaignSelection {
  id            String   @id @default(cuid())
  campaignId    String
  opportunityId String
  selectedAt    DateTime @default(now())
  selectedBy    String?

  /// The opportunity's value at the moment it was selected. Frozen here so
  /// "what pipeline did we choose to intervene on?" stays exact, rather than
  /// being inferred later from a mutable cache.
  amountAtSelection    Float?
  stageAtSelection     String?
  closeDateAtSelection DateTime?

  campaign    Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([campaignId, opportunityId])
  @@index([campaignId])
}

/// Append-only observation history for CFO reporting.
///
/// The Opportunity row is a mutable cache: every catalog refresh overwrites
/// amount, stage and close date, destroying the previous values. This table is
/// the durable record of what was true and when, so pipeline-by-stage over
/// time, value over time, and stage movement remain answerable without
/// re-reading Salesforce — which overwrites its own history too.
///
/// A row is written only when a tracked field CHANGES (plus at campaign launch
/// and when an outcome is observed), which makes this a change log rather than
/// a daily fact dump.
///
/// Deliberately contains NO attribution. Interventions and outcomes are stored
/// as independent timestamped facts; whether one influenced the other is a
/// query-time methodology that can be defined and revised later. Encoding a
/// causal claim here would make it permanent.
model OpportunitySnapshot {
  id            String   @id @default(cuid())
  /// Nullable on purpose: a history row must outlive the Opportunity it
  /// describes. `externalId` is the durable key.
  opportunityId String?
  /// Salesforce Id, denormalised so history survives a local cache rebuild.
  externalId    String
  observedAt    DateTime @default(now())
  /// CATALOG_REFRESH | CAMPAIGN_LAUNCH | OUTCOME_OBSERVED
  source        String

  amount    Float
  stage     String
  closeDate DateTime?
  isOpen    Boolean
  /// Null while the opportunity is still open.
  isWon     Boolean?

  /// Names are denormalised on purpose: a historical row must stay readable
  /// even if the account is renamed or the rep leaves.
  accountId       String?
  accountName     String
  internalRepId   String?
  internalRepName String

  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([opportunityId, observedAt])
  @@index([observedAt])
  @@index([externalId])
  @@index([source])
}

/// A Smartsheet signal (reminder/task/comment/status change) cross-referenced
/// against the cached Opportunity/Account catalog. This is the automated
/// "context gathering" step that replaces a PM manually checking Salesforce
/// after getting a Smartsheet email — see signal-matching-service.ts for the
/// matching rules and smartsheet-signal-service.ts for ingestion + the
/// review/draft workflow. Nothing here writes back to Salesforce or Smartsheet.
model OpportunitySignal {
  id         String @id @default(cuid())
  /// Smartsheet row/event id — the join key back to the source sheet.
  externalId String @unique
  provider   String @default("smartsheet")

  sheetName      String
  /// REMINDER | TASK_DUE | COMMENT | STATUS_CHANGE
  signalType     String
  title          String
  message        String
  assignedToName String?
  dueDate        DateTime?
  occurredAt     DateTime
  sourceUrl      String?

  /// What Smartsheet actually carried, kept even after matching so the audit
  /// trail shows what the raw signal said versus what it was resolved to.
  rawAccountName           String?
  rawProjectName           String?
  rawOpportunityExternalId String?

  /// Set by signal-matching-service.ts. MATCHED | AMBIGUOUS | UNMATCHED.
  matchStatus   String  @default("UNMATCHED")
  matchReason   String?
  opportunityId String?
  accountId     String?

  /// PM workflow state. Purely local — no external sends or writes yet.
  status         String    @default("NEW") // NEW | REVIEWED | DRAFTED
  reviewedAt     DateTime?
  reviewedBy     String?
  draftResponse  String?
  draftedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  account     Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([matchStatus])
  @@index([status])
  @@index([opportunityId])
  @@index([accountId])
}

// ---------------------------------------------------------------------------
// Mock Salesforce org.
//
// These tables belong to the MOCK provider only — they stand in for the real
// org so the demo has a system of record that actually changes. Nothing outside
// src/server/integrations/salesforce/mock may read or write them.
// ---------------------------------------------------------------------------

model MockSalesforceUser {
  externalId String  @id
  name       String
  email      String
  isActive   Boolean @default(true)
}

model MockSalesforceAccount {
  externalId String  @id
  name       String
  /// Salesforce Account.Type picklist value, e.g. "Agency", "Distributor".
  type       String
  isActive   Boolean @default(true)
}

model MockSalesforceContact {
  externalId       String  @id
  accountExternalId String
  name             String
  email            String
  isActive         Boolean @default(true)
  /// Stands in for a "primary check-in contact" flag on the Contact record.
  isPrimary        Boolean @default(false)

  @@index([accountExternalId])
}

model MockSalesforceOpportunity {
  externalId        String    @id
  ownerExternalId   String
  /// The partner Account (agency/distributor/direct client).
  accountExternalId String
  name              String
  /// End customer / project site.
  siteName          String
  amount            Float
  stageName         String
  closeDate         DateTime?
  isClosed          Boolean   @default(false)
  /// Stands in for an Opportunity Contact Role naming a specific contact.
  contactExternalId String?
  description       String?
  lastModifiedAt    DateTime  @default(now())
  /// Simulates an org validation rule that rejects stage changes.
  syncBlocked       Boolean   @default(false)

  @@index([ownerExternalId])
  @@index([accountExternalId])
}
